<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- flutter_secure_storage 11.2.0 uses these SharedPreferences files by default.
         They contain encrypted credential data and wrapped device-bound key material. -->
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml" />
    <!-- Local media bytes and resumable operation metadata are device-bound. -->
    <exclude domain="file" path="sme-media" />
    <exclude domain="database" path="sme_mobile_media.db" />
    <exclude domain="database" path="sme_mobile_media.db-wal" />
    <exclude domain="database" path="sme_mobile_media.db-shm" />
    <exclude domain="database" path="sme_mobile_media.db-journal" />
    <!-- path_provider's application documents directory is
         <app-data>/app_flutter. The root domain is relative to <app-data>;
         the file domain is relative to files/. -->
    <exclude domain="root" path="app_flutter" />
</full-backup-content>
