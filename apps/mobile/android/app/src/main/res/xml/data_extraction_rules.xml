<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml" />
        <exclude domain="file" path="sme-media" />
        <exclude domain="file" path="app_flutter/sme-media" />
        <exclude domain="database" path="sme_mobile_media.db" />
        <exclude domain="database" path="sme_mobile_media.db-wal" />
        <exclude domain="database" path="sme_mobile_media.db-shm" />
        <exclude domain="file" path="sme-meeting-" />
        <exclude domain="file" path="app_flutter/sme-meeting-" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml" />
        <exclude domain="file" path="sme-media" />
        <exclude domain="file" path="app_flutter/sme-media" />
        <exclude domain="database" path="sme_mobile_media.db" />
        <exclude domain="database" path="sme_mobile_media.db-wal" />
        <exclude domain="database" path="sme_mobile_media.db-shm" />
        <exclude domain="file" path="sme-meeting-" />
        <exclude domain="file" path="app_flutter/sme-meeting-" />
    </device-transfer>
</data-extraction-rules>
