# Canonical browser configuration for apps/web/.env.
# Only VITE_* values are exposed to the browser bundle. Never put credentials,
# private keys, database, broker, storage, or AI settings in this file.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CORE_API_BASE_URL=/api/v1
VITE_CORE_API_PROXY_TARGET=http://127.0.0.1:8080
