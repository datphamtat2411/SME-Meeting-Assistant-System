{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:sme:transcription-worker:1.0:corrected-result",
  "title":"Corrected Transcript V1",
  "description":"Maximum 8388608 exact UTF-8 bytes. Duplicate keys, BOM, malformed Unicode and scalar coercion are forbidden. Timeline, interval intersection, pinned warning registry, source binding and correction digest semantics are additionally enforced by Core as specified in the normative contract.",
  "type":"object",
  "additionalProperties":false,
  "required":["contractVersion","resultType","processingJobId","sourceMediaId","sourceRevision","producerStageRunId","pipelineStatus","languageCode","sampleRateHz","sampleCount","durationMs","segments","coverage","warnings","provenance","correctionProof"],
  "properties":{
    "contractVersion":{"const":"1.0"},
    "resultType":{"const":"CORRECTED_TRANSCRIPT"},
    "processingJobId":{"$ref":"#/$defs/uuid"},
    "sourceMediaId":{"$ref":"#/$defs/uuid"},
    "sourceRevision":{"$ref":"#/$defs/digest"},
    "producerStageRunId":{"$ref":"#/$defs/uuid"},
    "pipelineStatus":{"enum":["COMPLETED","COMPLETED_WITH_WARNINGS"]},
    "languageCode":{"$ref":"#/$defs/token","maxLength":16},
    "sampleRateHz":{"const":16000},
    "sampleCount":{"type":"integer","minimum":1,"maximum":230400000},
    "durationMs":{"type":"integer","minimum":1,"maximum":14400000},
    "segments":{"type":"array","minItems":1,"maxItems":16384,"items":{"$ref":"#/$defs/segment"}},
    "coverage":{"type":"array","minItems":1,"maxItems":65536,"items":{"$ref":"#/$defs/coverage"}},
    "warnings":{"type":"array","maxItems":4096,"items":{"$ref":"#/$defs/warning"}},
    "provenance":{"$ref":"#/$defs/provenance"},
    "correctionProof":{
      "type":"object","additionalProperties":false,"required":["contextScope","promptVersion","outputSha256"],
      "properties":{"contextScope":{"const":"WHOLE_MEETING"},"promptVersion":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$"},"outputSha256":{"$ref":"#/$defs/digest"}}
    }
  },
  "$defs":{
    "uuid":{"type":"string","format":"uuid","pattern":"^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"},
    "digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "token":{"type":"string","minLength":1,"pattern":"^[A-Za-z0-9][A-Za-z0-9_.:/-]*$","not":{"anyOf":[{"pattern":"://"},{"pattern":"\\.\\."}]}},
    "count":{"type":"integer","minimum":0,"maximum":2147483647},
    "segment":{
      "type":"object","additionalProperties":false,"required":["ordinal","startMs","endMs","text","qualityStatus"],
      "properties":{
        "ordinal":{"type":"integer","minimum":0,"maximum":16383},
        "startMs":{"type":"integer","minimum":0,"maximum":14399999},"endMs":{"type":"integer","minimum":1,"maximum":14400000},
        "text":{"type":"string","minLength":1,"maxLength":20000,"pattern":"\\S"},
        "qualityStatus":{"enum":["ACCEPTED","SUSPICIOUS","UNRESOLVED"]}
      }
    },
    "coverage":{
      "type":"object","additionalProperties":false,"required":["startMs","endMs","coverageStatus","recovered","retryCount"],
      "properties":{"startMs":{"type":"integer","minimum":0},"endMs":{"type":"integer","minimum":1},"coverageStatus":{"enum":["COVERED","SUSPICIOUS","UNRESOLVED_ERROR"]},"recovered":{"type":"boolean"},"retryCount":{"$ref":"#/$defs/count"}}
    },
    "warning":{
      "type":"object","additionalProperties":false,"required":["stage","code","startSample","endSample","sourceChunkIds","phase"],
      "properties":{
        "stage":{"enum":["PREPROCESSING","CHUNK_PLANNING","ASR","COVERAGE_RECOVERY","RECONCILIATION","CORRECTION"]},
        "code":{"type":"string","minLength":1,"maxLength":80},
        "startSample":{"type":["integer","null"],"minimum":0,"maximum":230399999},
        "endSample":{"type":["integer","null"],"minimum":1,"maximum":230400000},
        "sourceChunkIds":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/token","maxLength":128}},
        "phase":{"enum":[null,"initial","final","attempt"]}
      }
    },
    "provenance":{
      "type":"object","additionalProperties":false,"required":["pipelineVersion","configurationSha256","components","vadModel","models"],
      "properties":{
        "pipelineVersion":{"$ref":"#/$defs/token","maxLength":80},
        "configurationSha256":{"$ref":"#/$defs/digest"},
        "components":{"type":"array","minItems":1,"maxItems":16,"items":{
          "type":"object","additionalProperties":false,"required":["name","version"],
          "properties":{"name":{"$ref":"#/$defs/token","maxLength":128},"version":{"$ref":"#/$defs/token","maxLength":80}}
        }},
        "vadModel":{"type":"object","additionalProperties":false,"required":["modelId","modelVersion","sha256"],
          "properties":{"modelId":{"$ref":"#/$defs/token","maxLength":256},"modelVersion":{"$ref":"#/$defs/token","maxLength":80},"sha256":{"$ref":"#/$defs/digest"}}},
        "models":{"type":"array","minItems":1,"maxItems":64,"uniqueItems":true,"items":{
          "type":"object","additionalProperties":false,"required":["role","provider","requestedModel","resolvedModel"],
          "properties":{"role":{"enum":["ASR","CORRECTION"]},"provider":{"$ref":"#/$defs/token","maxLength":80},"requestedModel":{"$ref":"#/$defs/token","maxLength":256},"resolvedModel":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/token","maxLength":256}]}}
        }}
      }
    }
  }
}
