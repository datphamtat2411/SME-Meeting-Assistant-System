{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sme-meeting-assistant.invalid/api/meeting-intelligence-result-v1.schema.json",
  "title": "MI-01 proposed AI result exchange contract v1 (review required)",
  "description": "Draft API-owned ingress schema. Trusted job/stage/source and evidence are verified against PostgreSQL. The single result-artifact SHA-256 is verified from trusted storage metadata outside this JSON payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resultType",
    "processingJobId",
    "stageRunId",
    "source",
    "producer",
    "result"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "resultType": {
      "type": "string",
      "enum": [
        "SUMMARY",
        "DECISION_EXTRACTION"
      ]
    },
    "processingJobId": {
      "type": "string",
      "format": "uuid"
    },
    "stageRunId": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "result": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "resultType": {
            "const": "SUMMARY"
          }
        },
        "required": [
          "resultType"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/summaryResult"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "resultType": {
            "const": "DECISION_EXTRACTION"
          }
        },
        "required": [
          "resultType"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/decisionExtractionResult"
          }
        }
      }
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transcriptId",
        "contentRevision",
        "inputSnapshotId",
        "sha256"
      ],
      "properties": {
        "transcriptId": {
          "type": "string",
          "format": "uuid"
        },
        "contentRevision": {
          "type": "integer",
          "minimum": 0
        },
        "inputSnapshotId": {
          "type": "string",
          "format": "uuid"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "promptVersion"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u001F\\u007F-\\u009F]+(?![\\s\\S])"
        },
        "promptVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u001F\\u007F-\\u009F]+(?![\\s\\S])"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u001F\\u007F-\\u009F]+(?![\\s\\S])"
        }
      }
    },
    "summaryResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content",
        "warnings"
      ],
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "^(?=[\\s\\S]*\\S)(?![\\s\\S]*[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F])(?![\\s\\S]*\\r(?!\\n))[\\s\\S]+(?![\\s\\S])"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "INCOMPLETE_COVERAGE",
              "UNRESOLVED_EVIDENCE",
              "SUSPICIOUS_EVIDENCE",
              "SOURCE_QUALITY_WARNING",
              "GROUNDING_CLAIM_DISCARDED",
              "GROUNDING_CLAIM_REPAIRED"
            ]
          },
          "uniqueItems": true,
          "maxItems": 6
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/groundingDiagnostic"
          }
        },
        "diagnosticsVersion": {
          "const": "1.0"
        },
        "diagnosticCounts": {
          "$ref": "#/$defs/groundingDiagnosticCounts"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "diagnosticsVersion"
            ]
          },
          "then": {
            "required": [
              "diagnosticCounts"
            ]
          }
        },
        {
          "if": {
            "required": [
              "diagnosticCounts"
            ]
          },
          "then": {
            "required": [
              "diagnosticsVersion"
            ]
          }
        }
      ]
    },
    "decisionCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateKey",
        "content",
        "evidenceSegmentIds",
        "uncertainty"
      ],
      "properties": {
        "candidateKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000,
          "pattern": "^(?=[\\s\\S]*\\S)(?![\\s\\S]*[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F])(?![\\s\\S]*\\r(?!\\n))[\\s\\S]+(?![\\s\\S])"
        },
        "evidenceSegmentIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true
        },
        "uncertainty": {
          "type": "string",
          "enum": [
            "NONE",
            "LOW",
            "MATERIAL"
          ]
        }
      }
    },
    "decisionExtractionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidates",
        "warnings"
      ],
      "properties": {
        "candidates": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/decisionCandidate"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "INCOMPLETE_COVERAGE",
              "UNRESOLVED_EVIDENCE",
              "SUSPICIOUS_EVIDENCE",
              "SOURCE_QUALITY_WARNING",
              "GROUNDING_CLAIM_DISCARDED",
              "GROUNDING_CLAIM_REPAIRED"
            ]
          },
          "uniqueItems": true,
          "maxItems": 6
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/groundingDiagnostic"
          }
        },
        "diagnosticsVersion": {
          "const": "1.0"
        },
        "diagnosticCounts": {
          "$ref": "#/$defs/groundingDiagnosticCounts"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "diagnosticsVersion"
            ]
          },
          "then": {
            "required": [
              "diagnosticCounts"
            ]
          }
        },
        {
          "if": {
            "required": [
              "diagnosticCounts"
            ]
          },
          "then": {
            "required": [
              "diagnosticsVersion"
            ]
          }
        }
      ]
    },
    "groundingReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segmentId",
        "charStart",
        "charEnd"
      ],
      "properties": {
        "segmentId": {
          "type": "string",
          "format": "uuid"
        },
        "charStart": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "charEnd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        }
      }
    },
    "groundingEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSnapshotId",
        "transcriptId",
        "contentRevision",
        "sourceSha256",
        "references",
        "modelCategory",
        "statementSha256",
        "statementCharLength",
        "evidenceSha256",
        "evidenceCharLength",
        "affirmativeMarker",
        "negativeMarker",
        "assessment"
      ],
      "properties": {
        "sourceSnapshotId": {
          "type": "string",
          "format": "uuid"
        },
        "transcriptId": {
          "type": "string",
          "format": "uuid"
        },
        "contentRevision": {
          "type": "integer",
          "minimum": 0
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/groundingReference"
          },
          "uniqueItems": true
        },
        "modelCategory": {
          "type": "string",
          "pattern": "^[A-Z_]{1,32}$"
        },
        "statementSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "statementCharLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "evidenceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidenceCharLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "affirmativeMarker": {
          "type": "boolean"
        },
        "negativeMarker": {
          "type": "boolean"
        },
        "assessment": {
          "type": "string",
          "enum": [
            "SUPPORTED",
            "NEGATIVE_OR_TENTATIVE",
            "INCOMPLETE_CITATION",
            "POSSIBLE_VALIDATOR_FALSE_NEGATIVE",
            "UNSUPPORTED_MODEL_CLASSIFICATION"
          ]
        }
      }
    },
    "groundingDiagnosticLegacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "reason",
        "rule",
        "itemIndex",
        "evidence"
      ],
      "properties": {
        "disposition": {
          "type": "string",
          "enum": [
            "DISCARDED",
            "REPAIRED"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "INVALID_REFERENCE",
            "GROUNDING_FAILURE"
          ]
        },
        "rule": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "SOURCE_IDENTITY",
            "REFERENCE_SHAPE",
            "REFERENCE_SEGMENT_NOT_FOUND",
            "REFERENCE_RANGE",
            "REFERENCE_DUPLICATE",
            "REFERENCE_OUTSIDE_WINDOW",
            "REFERENCE_NOT_ALLOWED",
            "TEXT_POLICY",
            "STATEMENT_NOT_GROUNDED",
            "QUALIFICATION_NOT_GROUNDED",
            "UNSUPPORTED_NUMBER",
            "AGREEMENT_UNSUPPORTED",
            "AGREEMENT_CONTRADICTED",
            "REDUCTION_COVERAGE",
            "REDUCTION_EMPTY",
            "CLAIM_SECTION",
            "CLAIM_NOT_MATCHED",
            "CLAIM_UNCERTAINTY",
            "CLAIM_CONFLICT_UNRESOLVED",
            "CLAIM_NOT_GROUNDED",
            "CLAIM_RECORD_GROUNDING",
            "CLAIM_QUALIFICATION_GROUNDING",
            "MATERIAL_CLAIM_COVERAGE"
          ]
        },
        "itemIndex": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10000
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/groundingEvidence"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "groundingClaimDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnosticVersion",
        "stage",
        "disposition",
        "reason",
        "rule",
        "itemIndex",
        "fingerprint",
        "warningCodes",
        "evidence"
      ],
      "properties": {
        "diagnosticVersion": {
          "const": "1.0"
        },
        "stage": {
          "type": "string",
          "enum": [
            "GENERATING_SUMMARY",
            "EXTRACTING_DECISIONS",
            "EXTRACTING_ACTION_ITEMS"
          ]
        },
        "disposition": {
          "type": "string",
          "enum": [
            "ACCEPTED",
            "REJECTED"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "SUPPORTED",
            "UNSUPPORTED",
            "INVALID_REFERENCE",
            "MISSING_REFERENCE",
            "STALE",
            "CONTRADICTED",
            "UNCERTAIN",
            "REVISION_MISMATCH",
            "GROUNDING_FAILURE"
          ]
        },
        "rule": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "SOURCE_IDENTITY",
            "REFERENCE_SHAPE",
            "REFERENCE_SEGMENT_NOT_FOUND",
            "REFERENCE_RANGE",
            "REFERENCE_DUPLICATE",
            "REFERENCE_OUTSIDE_WINDOW",
            "REFERENCE_NOT_ALLOWED",
            "TEXT_POLICY",
            "STATEMENT_NOT_GROUNDED",
            "QUALIFICATION_NOT_GROUNDED",
            "UNSUPPORTED_NUMBER",
            "AGREEMENT_UNSUPPORTED",
            "AGREEMENT_CONTRADICTED",
            "REDUCTION_COVERAGE",
            "REDUCTION_EMPTY",
            "CLAIM_SECTION",
            "CLAIM_NOT_MATCHED",
            "CLAIM_UNCERTAINTY",
            "CLAIM_CONFLICT_UNRESOLVED",
            "CLAIM_NOT_GROUNDED",
            "CLAIM_RECORD_GROUNDING",
            "CLAIM_QUALIFICATION_GROUNDING",
            "MATERIAL_CLAIM_COVERAGE"
          ]
        },
        "itemIndex": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10000
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "warningCodes": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 6,
          "items": {
            "type": "string",
            "enum": [
              "INCOMPLETE_COVERAGE",
              "UNRESOLVED_EVIDENCE",
              "SUSPICIOUS_EVIDENCE",
              "SOURCE_QUALITY_WARNING",
              "GROUNDING_CLAIM_DISCARDED",
              "GROUNDING_CLAIM_REPAIRED"
            ]
          }
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/groundingEvidence"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "groundingDiagnostic": {
      "oneOf": [
        {
          "$ref": "#/$defs/groundingDiagnosticLegacy"
        },
        {
          "$ref": "#/$defs/groundingClaimDiagnostic"
        }
      ]
    },
    "groundingDiagnosticCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "accepted",
        "rejected",
        "discarded",
        "repaired",
        "total"
      ],
      "properties": {
        "version": {
          "const": "1.0"
        },
        "accepted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "rejected": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "discarded": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "repaired": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        }
      }
    }
  }
}
