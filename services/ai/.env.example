# Copy to .env for local use. Process environment variables take precedence.
AI_SERVICE_NAME=sme-meeting-ai
AI_SERVICE_IDENTITY=ai-core
# Quote JSON so both dotenv and uv --env-file preserve its inner quotes.
AI_INTERNAL_ALLOWED_CALLERS='["core-api"]'
AI_ENVIRONMENT=development
AI_DEBUG=false
AI_LOG_LEVEL=INFO
AI_HTTP_HOST=127.0.0.1
AI_HTTP_PORT=8000
AI_HTTP_SHUTDOWN_TIMEOUT_SECONDS=30
AI_WORKER_CONCURRENCY=1
AI_WORKER_SHUTDOWN_TIMEOUT_SECONDS=30
AI_WORKER_EXECUTION_TIMEOUT_SECONDS=14400

# Worker V1: configure private endpoints and externally mounted credentials before
# launching sme-ai-worker. Inbound AI_TLS_* does not configure outbound mTLS.
# AI_CORE_API_BASE_URL=https://core-api.internal:8443
# AI_CORE_API_SERVER_CA_FILE=/run/secrets/ai-worker/core-server-ca.crt
# AI_CORE_API_CLIENT_CERT_FILE=/run/secrets/ai-worker/worker-client.crt
# AI_CORE_API_CLIENT_KEY_FILE=/run/secrets/ai-worker/worker-client.key
AI_CORE_API_CONNECT_TIMEOUT_SECONDS=3
AI_CORE_API_TIMEOUT_SECONDS=15
AI_CORE_API_MAX_ATTEMPTS=3

# Broker URL contains no credentials; credentials come from approved secret storage.
# AI_RABBITMQ_URL=amqps://rabbitmq.internal:5671/%2F
# AI_RABBITMQ_USERNAME=<least-privilege-worker-user>
# AI_RABBITMQ_PASSWORD=<externally-provisioned-secret>
# AI_RABBITMQ_CA_FILE=/run/secrets/ai-worker/broker-ca.crt
AI_RABBITMQ_EXCHANGE=meeting.processing
AI_RABBITMQ_ROUTING_KEY=processing.job.queued
AI_RABBITMQ_QUEUE=meeting.processing.jobs
AI_RABBITMQ_DELIVERY_LIMIT=5
AI_RABBITMQ_CONNECT_TIMEOUT_SECONDS=10
# Prefetch is AI_WORKER_CONCURRENCY. Operations owns quorum/DLX provisioning.

# One deployment-allowlisted storage alias. Never use signed or public access URLs.
# AI_S3_ENDPOINT_URL=https://storage.internal
AI_S3_STORAGE_ID=private
AI_S3_REGION=us-east-1
# AI_S3_BUCKET=<private-media-bucket>
# AI_S3_ACCESS_KEY_ID=<least-privilege-access-key>
# AI_S3_SECRET_ACCESS_KEY=<externally-provisioned-secret>
# AI_S3_CA_FILE=/run/secrets/ai-worker/storage-ca.crt
AI_S3_PATH_STYLE=true
AI_S3_CONNECT_TIMEOUT_SECONDS=3
AI_S3_READ_TIMEOUT_SECONDS=15
AI_S3_DOWNLOAD_TIMEOUT_SECONDS=300

# File-backed audio normalization; install ffmpeg and ffprobe locally.
AI_AUDIO_MAX_INPUT_BYTES=536870912
AI_AUDIO_MAX_DURATION_SECONDS=3600
AI_AUDIO_MAX_OUTPUT_BYTES=134217728
AI_AUDIO_PROBE_TIMEOUT_SECONDS=10
AI_AUDIO_DECODE_TIMEOUT_SECONDS=900
AI_AUDIO_TEMP_DIR=/tmp

# Speech/energy evidence: externally provision a Silero v5-compatible ONNX file.
# Mount the model read-only. Loading is explicit; no runtime model downloads.
# AI_AUDIO_VAD_MODEL_PATH=/run/models/silero-vad.onnx
AI_AUDIO_VAD_MODEL_ID=silero-vad
AI_AUDIO_VAD_MODEL_VERSION=5
# AI_AUDIO_VAD_MODEL_SHA256=<expected-lowercase-64-character-sha256>
# Fixed by the supported Silero model contract; other frame sizes are rejected.
AI_AUDIO_VAD_FRAME_SAMPLES=512
AI_AUDIO_VAD_SPEECH_THRESHOLD=0.60
AI_AUDIO_VAD_NON_SPEECH_THRESHOLD=0.35
AI_AUDIO_VAD_TIMEOUT_SECONDS=900
AI_AUDIO_VAD_MODEL_MAX_BYTES=16777216
AI_AUDIO_VAD_MAX_CONCURRENT_RECORDINGS=1
AI_AUDIO_EVIDENCE_MAX_BYTES=16777216

# Candidate speech windows, boundary protection, and visible energy disagreement.
AI_AUDIO_SPEECH_MAP_BOUNDARY_PADDING_SAMPLES=1600
AI_AUDIO_SPEECH_MAP_MERGE_GAP_SAMPLES=512
AI_AUDIO_SPEECH_MAP_ENERGY_FLOOR_DBFS=-50

# Speech-aware ASR planning on the normalized 16 kHz sample timeline.
# Target + total adjacent request overlap must fit the maximum request size.
# Boundary search must be smaller than the target to guarantee forward progress.
AI_AUDIO_ASR_CHUNK_TARGET_SAMPLES=320000
AI_AUDIO_ASR_CHUNK_MAX_REQUEST_SAMPLES=480000
AI_AUDIO_ASR_CHUNK_OVERLAP_SAMPLES=80000
AI_AUDIO_ASR_CHUNK_BOUNDARY_SEARCH_SAMPLES=80000
AI_AUDIO_ASR_CHUNK_MAX_CHUNKS=4096

# Direct OpenRouter ASR of already-materialized chunks; output is provisional.
# Set OPENROUTER_API_KEY only in local .env or approved secret storage.
# OPENROUTER_API_KEY=
AI_AUDIO_ASR_MODEL=openai/whisper-large-v3
AI_AUDIO_ASR_LANGUAGE=vi
# Finite temperature in [0, 1]; timeout in (0, 600] seconds.
AI_AUDIO_ASR_TEMPERATURE=0
# Audio file limit: positive bytes, capped at 25 MiB.
AI_AUDIO_ASR_MAX_PAYLOAD_BYTES=26214400
AI_AUDIO_ASR_TIMEOUT_SECONDS=120
# Independent chunk calls; use a thread-safe transcriber above 1. Maximum: 4.
AI_AUDIO_ASR_MAX_CONCURRENT_CHUNKS=1

# Provider-independent assessment; absolute half-open 16 kHz sample intervals.
# Keep gap tolerance disabled unless a positive value has been evaluated.
# Only flanked, uncertainty-free speech-map artifacts can be tolerated (not ASR gaps).
AI_AUDIO_ASR_COVERAGE_MAX_TOLERATED_SPEECH_MAP_GAP_SAMPLES=0
# Strict integer in [1, 65536]; short repeated tokens are not repetition evidence.
AI_AUDIO_ASR_COVERAGE_REPETITION_MIN_CHARS=16
# Optional confidence is weak evidence only; finite threshold in [0, 1].
AI_AUDIO_ASR_COVERAGE_LOW_CONFIDENCE_THRESHOLD=0.35

# Bounded alternative-window speech recovery; sample counts are strict positive integers.
# Context is clipped to source bounds and the effective request/payload geometry.
AI_AUDIO_ASR_RECOVERY_CONTEXT_SAMPLES=16000
# Per-region attempt limit: [1, 64]; total attempt limit: [1, 256].
AI_AUDIO_ASR_RECOVERY_MAX_ATTEMPTS_PER_REGION=3
# Sample budgets count all requested samples, including context and failed calls.
# Context/sample settings are capped at 230400000 samples (four hours at 16 kHz).
AI_AUDIO_ASR_RECOVERY_MAX_REQUEST_SAMPLES_PER_REGION=1440000
AI_AUDIO_ASR_RECOVERY_MAX_TOTAL_ATTEMPTS=16
AI_AUDIO_ASR_RECOVERY_MAX_TOTAL_REQUEST_SAMPLES=2400000
# Finite (0, 3600] seconds. Reserve a full provider timeout before each new call;
# if remaining wall time is smaller than AI_AUDIO_ASR_TIMEOUT_SECONDS, stop.
AI_AUDIO_ASR_RECOVERY_MAX_WALL_TIME_SECONDS=300

# Provisional wording reconciliation: strict integer in [2, 64].
# Partial stitching also requires positive absolute overlap and unique alignment.
AI_AUDIO_ASR_RECONCILIATION_MIN_SHARED_TOKENS=2

# Whole-meeting correction: reuse OPENROUTER_API_KEY. Set a deployment-approved
# instruction model before invoking correction; there is no default model.
# AI_TRANSCRIPT_CORRECTION_MODEL=vendor/approved-instruction-model
# Finite timeout (0, 600]; strict integer attempts [1, 3].
AI_TRANSCRIPT_CORRECTION_TIMEOUT_SECONDS=120
AI_TRANSCRIPT_CORRECTION_MAX_ATTEMPTS=2
# Input + output allowances must fit the configured model context window.
# Conservative serialized-byte token budgeting rejects overflow, never truncates.
# Context/input: [1, 2000000]; output: [1, 131072]; response bytes: [1, 16777216].
AI_TRANSCRIPT_CORRECTION_CONTEXT_WINDOW_TOKENS=131072
AI_TRANSCRIPT_CORRECTION_MAX_INPUT_TOKENS=98304
AI_TRANSCRIPT_CORRECTION_MAX_OUTPUT_TOKENS=32768
AI_TRANSCRIPT_CORRECTION_MAX_RESPONSE_BYTES=4194304
# Finite temperature [0, 1]; integrity ratios: minimum (0, 1], maximum [1, 3].
AI_TRANSCRIPT_CORRECTION_TEMPERATURE=0
AI_TRANSCRIPT_CORRECTION_MIN_TEXT_RATIO=0.65
AI_TRANSCRIPT_CORRECTION_MAX_TEXT_RATIO=1.5

# Direct mTLS: set all three to CONTAINER paths in one read-only directory mount.
# AI_TLS_CERT_FILE=/run/secrets/ai-core/ai-server.crt
# AI_TLS_KEY_FILE=/run/secrets/ai-core/ai-server.key
# AI_TLS_CLIENT_CA_FILE=/run/secrets/ai-core/client-ca.crt
# Client trust is distinct from the issuer CA used to verify the server chain.
# Development host renewal uses external DEV_PKI_* settings, never this .env.
# See docs/DEV-PKI-OPERATIONS.md; do not add secrets or host-local paths here.
