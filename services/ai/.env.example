# Copy to .env for local use. Process environment variables take precedence.
AI_SERVICE_NAME=sme-meeting-ai
AI_SERVICE_IDENTITY=ai-core
AI_INTERNAL_ALLOWED_CALLERS=["core-api"]
AI_ENVIRONMENT=development
AI_DEBUG=false
AI_LOG_LEVEL=INFO
AI_HTTP_HOST=127.0.0.1
AI_HTTP_PORT=8000
AI_HTTP_SHUTDOWN_TIMEOUT_SECONDS=30
AI_WORKER_CONCURRENCY=1
AI_WORKER_SHUTDOWN_TIMEOUT_SECONDS=30

# Direct mTLS: set all three to CONTAINER paths in one read-only directory mount.
# AI_TLS_CERT_FILE=/run/secrets/ai-core/ai-server.crt
# AI_TLS_KEY_FILE=/run/secrets/ai-core/ai-server.key
# AI_TLS_CLIENT_CA_FILE=/run/secrets/ai-core/client-ca.crt
# Client trust is distinct from the issuer CA used to verify the server chain.
# Development host renewal uses external DEV_PKI_* settings, never this .env.
# See docs/DEV-PKI-OPERATIONS.md; do not add secrets or host-local paths here.
