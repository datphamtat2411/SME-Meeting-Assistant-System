# Copy to .env for local use. Process environment variables take precedence.
AI_SERVICE_NAME=sme-meeting-ai
AI_ENVIRONMENT=development
AI_DEBUG=false
AI_LOG_LEVEL=INFO
AI_HTTP_HOST=127.0.0.1
AI_HTTP_PORT=8000
AI_WORKER_CONCURRENCY=1

# AI_INTERNAL_SERVICE_TOKEN is optional. Supply it privately when needed.
# Never commit real tokens to this example.
