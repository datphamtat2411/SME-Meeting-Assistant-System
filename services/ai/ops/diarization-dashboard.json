{
  "__inputs": [{"name":"DS_PROMETHEUS","label":"Prometheus","type":"datasource","pluginId":"prometheus","pluginName":"Prometheus"}],
  "uid":"spk12-diarization","title":"SPK-12 Diarization — durable database gauges","schemaVersion":39,"version":1,
  "tags":["diarization","private"],"timezone":"browser","refresh":"1m","time":{"from":"now-24h","to":"now"},
  "templating":{"list":[
    {"name":"environment","type":"query","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"query":"label_values(up{job=\"core-diarization\"}, environment)","refresh":1},
    {"name":"cluster","type":"query","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"query":"label_values(up{job=\"core-diarization\",environment=\"$environment\"}, cluster)","refresh":1}
  ]},
  "panels":[
    {"id":1,"type":"timeseries","title":"Accepted / failed attempts (rolling 24h)","gridPos":{"x":0,"y":0,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"targets":[{"refId":"A","expr":"max by(outcome) (diarization_window_outcomes{job=\"core-diarization\",environment=\"$environment\",cluster=\"$cluster\"})","legendFormat":"{{outcome}}"}]},
    {"id":2,"type":"timeseries","title":"Mean execution seconds (rolling 24h)","gridPos":{"x":12,"y":0,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"targets":[{"refId":"A","expr":"max by(outcome) (diarization_window_stage_duration_seconds{job=\"core-diarization\",environment=\"$environment\",cluster=\"$cluster\"}) / (max by(outcome) (diarization_window_stage_duration_count{job=\"core-diarization\",environment=\"$environment\",cluster=\"$cluster\"}) > 0)","legendFormat":"{{outcome}}"}]},
    {"id":3,"type":"timeseries","title":"Retry attempts (rolling 24h)","gridPos":{"x":0,"y":8,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"targets":[{"refId":"A","expr":"max(diarization_window_retries{job=\"core-diarization\",environment=\"$environment\",cluster=\"$cluster\"})"}]},
    {"id":4,"type":"timeseries","title":"Execution distribution — cumulative counts ≤ seconds","gridPos":{"x":12,"y":8,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"targets":[{"refId":"A","expr":"max by(le_seconds) (diarization_window_stage_duration{job=\"core-diarization\",environment=\"$environment\",cluster=\"$cluster\"})","legendFormat":"≤ {{le_seconds}} s"}]},
    {"id":5,"type":"timeseries","title":"Speaker distribution — cumulative accepted attempts","gridPos":{"x":0,"y":16,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"targets":[{"refId":"A","expr":"max by(le) (diarization_window_speakers{job=\"core-diarization\",environment=\"$environment\",cluster=\"$cluster\"})","legendFormat":"≤ {{le}} speakers"}]},
    {"id":6,"type":"timeseries","title":"Unknown assignment distribution — cumulative accepted attempts","gridPos":{"x":12,"y":16,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"targets":[{"refId":"A","expr":"max by(le) (diarization_window_unknown_assignments{job=\"core-diarization\",environment=\"$environment\",cluster=\"$cluster\"})","legendFormat":"≤ {{le}} segments"}]},
    {"id":7,"type":"timeseries","title":"Verified-only outstanding (all history)","gridPos":{"x":0,"y":24,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"targets":[{"refId":"A","expr":"max(diarization_verified_only_outstanding{job=\"core-diarization\",environment=\"$environment\",cluster=\"$cluster\"})"}]},
    {"id":8,"type":"timeseries","title":"Verified-only classification (all history)","gridPos":{"x":12,"y":24,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"targets":[{"refId":"A","expr":"max by(state) (diarization_verified_only_count{job=\"core-diarization\",environment=\"$environment\",cluster=\"$cluster\"})","legendFormat":"{{state}}"}]},
    {"id":9,"type":"timeseries","title":"Oldest unresolved verification age (seconds)","gridPos":{"x":0,"y":32,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"targets":[{"refId":"A","expr":"max(diarization_verified_only_oldest_age_seconds{job=\"core-diarization\",environment=\"$environment\",cluster=\"$cluster\"})"}]},
    {"id":10,"type":"timeseries","title":"Lease expiration receipts (rolling 24h)","gridPos":{"x":12,"y":32,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"targets":[{"refId":"A","expr":"max(diarization_window_lease_expirations{job=\"core-diarization\",environment=\"$environment\",cluster=\"$cluster\"})"}]},
    {"id":11,"type":"timeseries","title":"Aggregation health by Core replica (1 healthy)","gridPos":{"x":0,"y":40,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"targets":[{"refId":"A","expr":"diarization_metrics_aggregation_healthy{job=\"core-diarization\",environment=\"$environment\",cluster=\"$cluster\"}","legendFormat":"{{instance}}"}]},
    {"id":12,"type":"timeseries","title":"Private exporter availability by replica (1 up)","gridPos":{"x":12,"y":40,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"targets":[{"refId":"A","expr":"up{job=\"core-diarization\",environment=\"$environment\",cluster=\"$cluster\"}","legendFormat":"{{instance}}"}]}
  ]
}
