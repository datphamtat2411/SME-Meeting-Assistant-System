# SME Meeting Assistant - Core API (local secure integration)
# Copy this file to services/api/.env and replace the blank secrets and example paths.
# Never commit services/api/.env. Do not put real passwords, API keys or private keys here.
# This template mirrors the locally verified E2E-04 settings (8 MiB / 60 s WAV uploads).

# ============================================================
# 1. SPRING & CORE PRIVATE mTLS
# ============================================================
SPRING_PROFILES_ACTIVE=secure-integration
APP_ENVIRONMENT=development
APP_TRANSPORT_PRIVATE_ENABLED=true
APP_TRANSPORT_PRIVATE_ADDRESS=127.0.0.1
APP_TRANSPORT_PRIVATE_PORT=8443
APP_TRANSPORT_PRIVATE_HOSTNAME=core-api.internal
APP_TRANSPORT_PRIVATE_CERTIFICATE=/absolute/path/to/core-server/tls.crt
APP_TRANSPORT_PRIVATE_KEY=/absolute/path/to/core-server/tls.key
APP_TRANSPORT_PRIVATE_ISSUER_CA=/absolute/path/to/core-server/issuer-ca.crt
APP_TRANSPORT_PRIVATE_CLIENT_CA=/absolute/path/to/core-server/client-ca.crt
# SPK-12: opt-in monitoring shares only the private connector. Requires a separately
# enrolled clientAuth certificate URI urn:sme:service:monitoring and collector-only
# network ingress. Public Actuator exposure remains health-only. See AI ops runbook.
APP_MONITORING_PRIVATE_ENABLED=false

# ============================================================
# 2. CORE -> AI HTTP (outbound mTLS)
# ============================================================
APP_TRANSPORT_AI_ENABLED=true
APP_TRANSPORT_AI_PROBE=true
APP_TRANSPORT_AI_BASE_URL=https://localhost:8000
APP_TRANSPORT_AI_SERVER_CA=/absolute/path/to/core-client/ai-server-ca.crt
APP_TRANSPORT_AI_ISSUER_CA=/absolute/path/to/core-client/issuer-ca.crt
APP_TRANSPORT_AI_CERTIFICATE=/absolute/path/to/core-client/tls.crt
APP_TRANSPORT_AI_KEY=/absolute/path/to/core-client/tls.key

# ============================================================
# 3. POSTGRESQL
# ============================================================
# The repo-root run-core.sh reads infra/local/postgres/.env and maps:
#   DB_URL=jdbc:postgresql://127.0.0.1:5433/${POSTGRES_DB}
#   DB_USERNAME=${POSTGRES_USER}
#   DB_PASSWORD=${POSTGRES_PASSWORD}
# If starting Core without run-core.sh, provide DB_URL, DB_USERNAME and DB_PASSWORD
# in the process environment; the default local Docker host port is 5433.
DB_URL=jdbc:postgresql://127.0.0.1:5433/sme_meeting_dev
DB_USERNAME=sme_dev
DB_PASSWORD=123456

# ============================================================
# 4. RABBITMQ (Core publisher + DLQ reconciler)
# ============================================================
RABBITMQ_HOST=rabbitmq.internal
RABBITMQ_PORT=5671
RABBITMQ_VIRTUAL_HOST=sme-integration
RABBITMQ_CA_FILE=/absolute/path/to/core-client/broker-ca.crt
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_RECONCILER_USERNAME=
RABBITMQ_RECONCILER_PASSWORD=

# ============================================================
# 5. RUSTFS / S3 (Core's least-privilege IAM identity)
# ============================================================
APP_MEDIA_STORAGE_ENDPOINT=https://storage.internal:9443
APP_MEDIA_STORAGE_CA_FILE=/absolute/path/to/core-client/storage-ca.crt
APP_MEDIA_STORAGE_REGION=us-east-1
APP_MEDIA_STORAGE_BUCKET=meeting-media
APP_MEDIA_STORAGE_CREATE_BUCKET_IF_MISSING=false
APP_MEDIA_STORAGE_ACCESS_KEY=
APP_MEDIA_STORAGE_SECRET_KEY=
# APP_MEDIA_STORAGE_PATH_STYLE_ACCESS=true  # default in application.properties

# ============================================================
# 6. AUTHENTICATION, JWT & SECURITY
# ============================================================
APP_AUTH_JWT_PRIVATE_KEY_LOCATION=file:/absolute/path/to/core-auth/jwt-private.pem
APP_AUTH_JWT_PUBLIC_KEY_LOCATION=file:/absolute/path/to/core-auth/jwt-public.pem
APP_AUTH_JWT_KEY_ID=local-dev-key
APP_AUTH_JWT_ISSUER=https://issuer.local.invalid
APP_AUTH_JWT_AUDIENCE=sme-core-api-local
# Each *_KEY below needs its own newly generated, properly encoded secret.
APP_ACCOUNT_SETUP_SIGNING_KEY=
APP_AUTH_CSRF_SIGNING_KEY=
APP_AUTH_ABUSE_HASHING_KEY=
APP_AUTH_TRANSPORT_ENABLED=true
APP_ACCOUNT_SETUP_WORKER_ENABLED=false
APP_EMAIL_DELIVERY_WORKER_ENABLED=false
APP_AUTH_RECOVERY_ENABLED=false
APP_HTTP_SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ============================================================
# 7. MEDIA UPLOAD (E2E-04 FIXTURE LIMITS, NOT PRODUCTION LIMITS)
# ============================================================
APP_MEDIA_UPLOAD_ALLOWED_EXTENSIONS=wav
APP_MEDIA_UPLOAD_ALLOWED_CONTENT_TYPES=audio/wav
APP_MEDIA_UPLOAD_MAX_SIZE_BYTES=8388608
APP_MEDIA_UPLOAD_MAX_DURATION_MS=60000
# APP_MEDIA_UPLOAD_FFPROBE_PATH=ffprobe
# APP_MEDIA_UPLOAD_PROBE_TIMEOUT=PT30S
# APP_MEDIA_UPLOAD_URL_TTL=PT15M
# APP_MEDIA_DOWNLOAD_URL_TTL=PT5M

# ============================================================
# 8. OUTBOX / TRANSCRIPTION WORKER INTEGRATION
# ============================================================
APP_WORKER_TRANSCRIPTION_STORAGE_ID=private
APP_MEDIA_OUTBOX_ENABLED=true
APP_WORKER_TRANSCRIPTION_ENABLED=true
APP_WORKER_TRANSCRIPTION_INFRASTRUCTURE_VERIFIED=true
APP_WORKER_DEAD_LETTER_ENABLED=true

# IMPORTANT: application-secure-integration.properties hardcodes
# app.media.outbox.enabled=false and app.worker.transcription.enabled=false.
# The repo-root run-core.sh overrides these at runtime using SPRING_APPLICATION_JSON.
# The four env flags above alone do NOT activate those features under this profile.
