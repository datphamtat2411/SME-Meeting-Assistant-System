# SME Meeting Assistant - Core API
# Canonical application configuration for services/api/.env.
# Never commit services/api/.env. Do not put real passwords, API keys or private keys here.
# PostgreSQL bootstrap values belong only to infra/local/postgres/.env. run-core.sh
# maps them to DB_URL, DB_USERNAME and DB_PASSWORD at launch.

# ============================================================
# 1. SPRING & CORE PRIVATE mTLS
# ============================================================
SPRING_PROFILES_ACTIVE=secure-integration
APP_ENVIRONMENT=development
APP_TRANSPORT_PRIVATE_ENABLED=true
APP_TRANSPORT_PRIVATE_ADDRESS=127.0.0.1
APP_TRANSPORT_PRIVATE_PORT=8443
APP_TRANSPORT_PRIVATE_HOSTNAME=core-api.internal
APP_TRANSPORT_PRIVATE_CERTIFICATE=/absolute/path/to/core-server/tls.crt
APP_TRANSPORT_PRIVATE_KEY=/absolute/path/to/core-server/tls.key
APP_TRANSPORT_PRIVATE_ISSUER_CA=/absolute/path/to/core-server/issuer-ca.crt
APP_TRANSPORT_PRIVATE_CLIENT_CA=/absolute/path/to/core-server/client-ca.crt
# SPK-12: opt-in monitoring shares only the private connector. Requires a separately
# enrolled clientAuth certificate URI urn:sme:service:monitoring and collector-only
# network ingress. Public Actuator exposure remains health-only. See AI ops runbook.
APP_MONITORING_PRIVATE_ENABLED=false

# ============================================================
# 2. CORE -> AI HTTP (outbound mTLS)
# ============================================================
APP_TRANSPORT_AI_ENABLED=true
APP_TRANSPORT_AI_PROBE=true
APP_TRANSPORT_AI_BASE_URL=https://localhost:8000
APP_TRANSPORT_AI_SERVER_CA=/absolute/path/to/core-client/ai-server-ca.crt
APP_TRANSPORT_AI_ISSUER_CA=/absolute/path/to/core-client/issuer-ca.crt
APP_TRANSPORT_AI_CERTIFICATE=/absolute/path/to/core-client/tls.crt
APP_TRANSPORT_AI_KEY=/absolute/path/to/core-client/tls.key

# ============================================================
# 3. RABBITMQ (Core publisher + DLQ reconciler)
# ============================================================
RABBITMQ_HOST=rabbitmq.internal
RABBITMQ_PORT=5671
RABBITMQ_VIRTUAL_HOST=sme-integration
RABBITMQ_CA_FILE=/absolute/path/to/core-client/broker-ca.crt
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_RECONCILER_USERNAME=
RABBITMQ_RECONCILER_PASSWORD=
RABBITMQ_CONNECT_HOST=127.0.0.1
RABBITMQ_TLS_SERVER_NAME=rabbitmq.internal

# ============================================================
# 4. RUSTFS / S3 (Core's least-privilege IAM identity)
# ============================================================
APP_MEDIA_STORAGE_ENDPOINT=https://storage.internal:9443
APP_MEDIA_STORAGE_CA_FILE=/absolute/path/to/core-client/storage-ca.crt
APP_MEDIA_STORAGE_CONNECT_HOST=127.0.0.1
APP_MEDIA_STORAGE_TLS_SERVER_NAME=storage.internal
APP_MEDIA_STORAGE_REGION=us-east-1
APP_MEDIA_STORAGE_BUCKET=meeting-media
APP_MEDIA_STORAGE_CREATE_BUCKET_IF_MISSING=false
APP_MEDIA_STORAGE_ACCESS_KEY=
APP_MEDIA_STORAGE_SECRET_KEY=
# APP_MEDIA_STORAGE_PATH_STYLE_ACCESS=true  # default in application.properties

# ============================================================
# 5. AUTHENTICATION, JWT & SECURITY
# ============================================================
APP_AUTH_JWT_PRIVATE_KEY_LOCATION=file:/absolute/path/to/core-auth/jwt-private.pem
APP_AUTH_JWT_PUBLIC_KEY_LOCATION=file:/absolute/path/to/core-auth/jwt-public.pem
APP_AUTH_JWT_KEY_ID=local-dev-key
APP_AUTH_JWT_ISSUER=https://issuer.local.invalid
APP_AUTH_JWT_AUDIENCE=sme-core-api-local
# Each *_KEY below needs its own newly generated, properly encoded secret.
APP_ACCOUNT_SETUP_SIGNING_KEY=
APP_AUTH_CSRF_SIGNING_KEY=
APP_AUTH_ABUSE_HASHING_KEY=
APP_AUTH_TRANSPORT_ENABLED=true
APP_ACCOUNT_SETUP_WORKER_ENABLED=false
APP_EMAIL_DELIVERY_WORKER_ENABLED=false
APP_AUTH_RECOVERY_ENABLED=false
APP_HTTP_SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ============================================================
# 6. MEDIA UPLOAD (1 GiB source, 90-minute timeline)
# ============================================================
APP_MEDIA_UPLOAD_ALLOWED_EXTENSIONS=wav,mp3,m4a
APP_MEDIA_UPLOAD_ALLOWED_CONTENT_TYPES=audio/wav,audio/mpeg,audio/mp4
APP_MEDIA_UPLOAD_MAX_SIZE_BYTES=1073741824
APP_MEDIA_UPLOAD_MAX_DURATION_MS=5400000
# APP_MEDIA_UPLOAD_FFPROBE_PATH=ffprobe
# APP_MEDIA_UPLOAD_PROBE_TIMEOUT=PT30S
# APP_MEDIA_UPLOAD_SOURCE_TRANSFER_TIMEOUT=PT8M
# APP_MEDIA_UPLOAD_URL_TTL=PT15M
# APP_MEDIA_DOWNLOAD_URL_TTL=PT5M

# ============================================================
# 7. OUTBOX / TRANSCRIPTION WORKER INTEGRATION
# ============================================================
APP_WORKER_TRANSCRIPTION_STORAGE_ID=private
APP_MEDIA_OUTBOX_ENABLED=true
APP_WORKER_TRANSCRIPTION_ENABLED=true
APP_WORKER_TRANSCRIPTION_INFRASTRUCTURE_VERIFIED=true
APP_WORKER_DEAD_LETTER_ENABLED=true

# ============================================================
# 8. KNOWLEDGE / MEETING INTELLIGENCE CORE GATES (DISABLED BY DEFAULT)
# ============================================================
# These gates are separate from AI worker feature flags. Keep all false/empty
# until broker, storage, mTLS, acceptance, privacy, and rollout approvals pass.
APP_MEDIA_INTELLIGENCE_ENABLED=false
APP_MEDIA_INTELLIGENCE_DISPATCH_ENABLED=false
APP_MEDIA_INTELLIGENCE_REGENERATION_ENABLED=false
APP_MEDIA_INTELLIGENCE_INFRASTRUCTURE_VERIFIED=false
APP_MEDIA_INTELLIGENCE_DISPATCH_CLAIM_TIMEOUT_SECONDS=1800
# For an approved run, use the same ordered MI stage subset in both stage-list
# settings. Leave both empty in the baseline configuration.
# APP_MEDIA_INTELLIGENCE_STORAGE_ID is a logical alias only; it must match the
# existing MI worker AI_S3_STORAGE_ID and does not provision a bucket or user.
APP_MEDIA_INTELLIGENCE_STORAGE_ID=
APP_MEDIA_INTELLIGENCE_ENABLED_STAGES=
APP_MEDIA_PROCESSING_REQUIRED_DOWNSTREAM_STAGES=
APP_MEDIA_PROCESSING_ACTION_ITEM_HANDOFF_ENABLED=false
# Durable MI provider-attempt budget; provider account-level spending is not
# asserted by these application estimate limits.
APP_MEDIA_INTELLIGENCE_SUMMARY_ATTEMPT_CEILING=16
APP_MEDIA_INTELLIGENCE_DECISION_ATTEMPT_CEILING=16
APP_MEDIA_INTELLIGENCE_ACTION_ITEM_ATTEMPT_CEILING=12
APP_MEDIA_INTELLIGENCE_AGGREGATE_ATTEMPT_CEILING=44
APP_MEDIA_INTELLIGENCE_RESERVED_TOKEN_CEILING=2000000
APP_MEDIA_INTELLIGENCE_ESTIMATED_COST_CEILING_USD=0.75
APP_MEDIA_INTELLIGENCE_INPUT_COST_PER_MILLION_USD=0.20
APP_MEDIA_INTELLIGENCE_OUTPUT_COST_PER_MILLION_USD=1.00
APP_MEDIA_OUTBOX_INTELLIGENCE_ROUTING_KEY=processing.intelligence.requested
APP_MI_INTERNAL_RESULT_ENABLED=false
APP_MI_INTERNAL_RESULT_TOKEN=
# Keep the token in a mode-0600 external one-line source; the Core launcher
# resolves this reference without exposing it in the repository.
# APP_MI_INTERNAL_RESULT_TOKEN_FILE=/absolute/path/to/mi-core-result-acceptance-token
APP_MI_INTERNAL_RESULT_PREVIOUS_TOKEN=
APP_MI_ORPHAN_CLEANUP_ENABLED=false
APP_MI_ORPHAN_CLEANUP_DRY_RUN=true
APP_MI_ORPHAN_CLEANUP_MIN_AGE=PT0S
APP_MI_ORPHAN_CLEANUP_POLL_MS=3600000
APP_MEDIA_KNOWLEDGE_INDEXING_ENABLED=false
APP_ASSISTANT_ENABLED=false

# IMPORTANT: application-secure-integration.properties hardcodes
# app.media.outbox.enabled=false and app.worker.transcription.enabled=false.
# The repo-root run-core.sh overrides these at runtime using SPRING_APPLICATION_JSON.
# The four env flags above alone do NOT activate those features under this profile.
