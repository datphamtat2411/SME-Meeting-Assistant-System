# Canonical PostgreSQL bootstrap configuration for infra/local/postgres/.env.
# The password is consumed only by PostgreSQL and mapped to Core's DB_* names
# by run-core.sh. Never commit the local file or reuse an application secret.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=sme_meeting_dev
POSTGRES_USER=sme_dev
POSTGRES_PASSWORD=
