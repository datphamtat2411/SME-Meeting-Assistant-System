# Local development values only. Replace these before sharing the environment.
POSTGRES_DB=meeting_assistant
POSTGRES_USER=meeting_local
POSTGRES_PASSWORD=change-this-local-postgres-password

MINIO_ROOT_USER=meeting_local
MINIO_ROOT_PASSWORD=change-this-local-minio-password

RABBITMQ_DEFAULT_USER=meeting_local
RABBITMQ_DEFAULT_PASS=change-this-local-rabbitmq-password

# For the API process running on the host machine.
MEDIA_STORAGE_ENABLED=true
MEDIA_STORAGE_ENDPOINT=http://localhost:9000
MEDIA_STORAGE_ACCESS_KEY=meeting_local
MEDIA_STORAGE_SECRET_KEY=change-this-local-minio-password
MEDIA_STORAGE_BUCKET=meeting-media
MEDIA_MAX_UPLOAD_SIZE=100MB
MEDIA_MAX_REQUEST_SIZE=110MB
MEDIA_MESSAGING_ENABLED=true
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=meeting_local
RABBITMQ_PASSWORD=change-this-local-rabbitmq-password
