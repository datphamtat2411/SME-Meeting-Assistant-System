# PI-05 isolated E2E orchestration
# Canonical harness configuration for infra/local/pi05-isolated/.env.
# This file is not an application or infrastructure credential source.
# The live run loader still reads only private UUID-scoped files below
# $PI05_RUN_BASE_DIR; generated files are mode 0600 and are never committed.
# Do not copy this repository example into a live run. After the foundation is
# approved, create the private run-owned secrets/runtime-input.env manifest with
# PI05_CORE_*, PI05_AI_HTTP_*, PI05_TRANSCRIPTION_WORKER_*,
# PI05_MI_WORKER_*, PI05_KNOWLEDGE_WORKER_* and PI05_HARNESS_* prefixes, then
# run generate_runtime.py. It never reads this repository file.

PI05_RUN_BASE_DIR=$HOME/.local/share/sme-pi05/runs
PI05_RUN_ID=
PI05_RUN_ROOT=
PI05_SOURCE_COMMIT=
PI05_GENERATION_ID=
PI05_COLLECTION_NAME=
PI05_SCENARIO_TIMEOUT_SECONDS=900
PI05_POLL_INTERVAL_SECONDS=0.5
PI05_RABBIT_MINIMUM_MESSAGE_COUNT=1

# Set only for an explicitly approved isolated run. The normal backend startup
# never reads or creates these values.
PI05_ENABLE_L01=false
PI05_ENABLE_L02_L10=false
PI05_SCENARIO_SERVER_HOST=127.0.0.1
PI05_SCENARIO_SERVER_PORT=9443

# The following values are generated/mapped into private harness.env. Keep
# them blank here unless this canonical harness module is being configured for
# a new run-owned identity. Never reuse a shared Core, AI, broker or storage
# credential.
PI05_ACTION_EMAIL=
PI05_ACTION_PASSWORD=
PI05_OBSERVER_EMAIL=
PI05_OBSERVER_PASSWORD=
PI05_REVOKED_MEMBER_EMAIL=
PI05_REVOKED_MEMBER_PASSWORD=
PI05_MEDIA_FILE=
PI05_SCENARIO_FIXTURES_FILE=

# Run-owned endpoint/certificate metadata is populated after the isolated
# Compose port and PKI checks. TLS identity names are fixed by the harness.
PI05_CORE_BASE_URL=
PI05_CORE_CA_FILE=
PI05_CORE_CERT_FILE=
PI05_CORE_KEY_FILE=
PI05_CORE_OBSERVER_CERT_FILE=
PI05_CORE_OBSERVER_KEY_FILE=
PI05_CORE_LEAF_SHA256=
PI05_CORE_CONNECT_HOST=127.0.0.1
PI05_CORE_TLS_SERVER_NAME=core-api.internal
PI05_AI_BASE_URL=
PI05_AI_CA_FILE=
PI05_AI_CERT_FILE=
PI05_AI_KEY_FILE=
PI05_AI_LEAF_SHA256=
PI05_STORAGE_ENDPOINT_URL=
PI05_STORAGE_BUCKET=
PI05_STORAGE_ACCESS_KEY=
PI05_STORAGE_SECRET_KEY=
PI05_STORAGE_CA_FILE=
PI05_STORAGE_LEAF_SHA256=
PI05_STORAGE_TLS_SERVER_NAME=storage.internal
PI05_STORAGE_HOST_HEADER=storage.internal
PI05_STORAGE_OBJECT_PREFIX=
PI05_RABBIT_URL=
PI05_RABBIT_CA_FILE=
PI05_RABBIT_USERNAME=
PI05_RABBIT_PASSWORD=
PI05_RABBIT_LEAF_SHA256=
PI05_RABBIT_TLS_SERVER_NAME=rabbitmq.internal
PI05_RABBIT_QUEUE=
PI05_QDRANT_CA_FILE=
PI05_QDRANT_API_KEY=
