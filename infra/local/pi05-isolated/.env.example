# PI-05 isolated E2E orchestration
# Canonical orchestration metadata for infra/local/pi05-isolated/.env.
# This file contains no application credentials, certificates or generated
# process settings. The active loader reads only private UUID-scoped files
# below PI05_RUN_BASE_DIR; generated files are mode 0600 and never committed.
# The run-owned secrets/runtime-input.env manifest remains the sole source for
# Core, AI, worker and harness credentials. No module dotenv duplication is
# required.

PI05_RUN_BASE_DIR=~/.local/share/sme-pi05/runs
PI05_RUN_ID=
PI05_RUN_ROOT=
PI05_MANIFEST_PATH=
PI05_SOURCE_COMMIT=
PI05_GENERATION_ID=
PI05_COLLECTION_NAME=
PI05_ENVIRONMENT_KIND=DISPOSABLE
PI05_HARNESS_URL=
PI05_EVIDENCE_DIR=
PI05_PROOF_DIR=
PI05_SCENARIO_TIMEOUT_SECONDS=900
PI05_POLL_INTERVAL_SECONDS=0.5
PI05_RABBIT_MINIMUM_MESSAGE_COUNT=1
PI05_COMPOSE_FILE=infra/local/pi05-isolated/compose.yaml
PI05_REQUIRE_FRESH_PROJECT=true

# `./dev.sh admit` performs the fresh-project check. `./dev.sh e2e` performs
# only active-run readiness and never calls the fresh-project check.
