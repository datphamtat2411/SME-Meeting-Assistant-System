# Dedicated Meeting Intelligence worker environment. Copy outside Git, mode 0600.
# Container paths below are not valid host paths and must match read-only mounts.
AI_SERVICE_NAME=sme-meeting-ai-intelligence-worker
AI_SERVICE_IDENTITY=mi-worker
AI_ENVIRONMENT=development

# Capability and model gates remain off until the complete T08 checklist passes.
AI_MEETING_INTELLIGENCE_WORKER_ENABLED=false
AI_MEETING_INTELLIGENCE_WORKER_CONCURRENCY=1
AI_MEETING_INTELLIGENCE_WORKER_EXECUTION_TIMEOUT_SECONDS=1800
AI_MEETING_INTELLIGENCE_INFERENCE_ENABLED=false
AI_MEETING_INTELLIGENCE_SUMMARY_ENABLED=false
AI_MEETING_INTELLIGENCE_DECISION_ENABLED=false
AI_MEETING_INTELLIGENCE_ACTION_ITEM_ENABLED=false
AI_MEETING_INTELLIGENCE_MODEL=openai/gpt-6-luna
AI_MEETING_INTELLIGENCE_REASONING_EFFORT=high
AI_MEETING_INTELLIGENCE_CONTEXT_WINDOW_TOKENS=131072
AI_MEETING_INTELLIGENCE_MAX_INPUT_TOKENS=98304
AI_MEETING_INTELLIGENCE_MAX_OUTPUT_TOKENS=32768
AI_MEETING_INTELLIGENCE_MAX_TOTAL_INFERENCE_TOKENS=2000000
AI_MEETING_INTELLIGENCE_PROVIDER_TIMEOUT_SECONDS=120
AI_MEETING_INTELLIGENCE_MAX_ATTEMPTS=2
AI_MEETING_INTELLIGENCE_MAX_RESPONSE_BYTES=1048576
AI_MEETING_INTELLIGENCE_MAX_CONCURRENT_REQUESTS=1

# Reuse only the approved external provider secret; never put the value here.
# OPENROUTER_API_KEY=<externally-provisioned-secret>

# Private Core control/acceptance credentials. Each secret is distinct and
# delivered through the deployment secret manager, never broker/storage admin.
AI_MEETING_INTELLIGENCE_ACCEPTANCE_TOKEN=<externally-provisioned-secret>
AI_MEETING_INTELLIGENCE_CORE_API_CLIENT_CERT_FILE=/run/secrets/mi-worker/tls.crt
AI_MEETING_INTELLIGENCE_CORE_API_CLIENT_KEY_FILE=/run/secrets/mi-worker/tls.key
AI_CORE_API_BASE_URL=https://core-api.internal:8443
AI_CORE_API_SERVER_CA_FILE=/run/secrets/mi-worker/core-server-ca.crt
AI_CORE_API_CONNECT_TIMEOUT_SECONDS=3
AI_CORE_API_TIMEOUT_SECONDS=15
AI_CORE_API_MAX_ATTEMPTS=3

# Dedicated MI broker identity and queue TLS trust.
AI_MEETING_INTELLIGENCE_RABBITMQ_USERNAME=<externally-provisioned-secret>
AI_MEETING_INTELLIGENCE_RABBITMQ_PASSWORD=<externally-provisioned-secret>
AI_RABBITMQ_URL=amqps://rabbitmq.internal:5671/sme-integration
AI_RABBITMQ_CA_FILE=/run/secrets/mi-worker/broker-ca.crt
AI_RABBITMQ_CONNECT_TIMEOUT_SECONDS=10

# Dedicated MI storage identity: source snapshot reads and create-only result
# writes only. The Core API has no result-write grant.
AI_MEETING_INTELLIGENCE_S3_ACCESS_KEY_ID=<externally-provisioned-secret>
AI_MEETING_INTELLIGENCE_S3_SECRET_ACCESS_KEY=<externally-provisioned-secret>
AI_S3_ENDPOINT_URL=https://storage.internal:9000
AI_S3_CA_FILE=/run/secrets/mi-worker/storage-ca.crt
AI_S3_REGION=us-east-1
AI_S3_BUCKET=meeting-media
AI_S3_PATH_STYLE=true
AI_S3_CONNECT_TIMEOUT_SECONDS=3
AI_S3_READ_TIMEOUT_SECONDS=15
AI_S3_DOWNLOAD_TIMEOUT_SECONDS=300
