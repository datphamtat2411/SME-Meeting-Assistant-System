# Container paths. Host smoke tests must use corresponding absolute HOST paths/ports.
AI_SERVICE_NAME=sme-meeting-ai-worker
AI_SERVICE_IDENTITY=ai-worker
AI_ENVIRONMENT=development
AI_CORE_API_BASE_URL=https://core-api.internal:8443
AI_CORE_API_SERVER_CA_FILE=/run/secrets/ai-worker/core-server-ca.crt
AI_CORE_API_CLIENT_CERT_FILE=/run/secrets/ai-worker/tls.crt
AI_CORE_API_CLIENT_KEY_FILE=/run/secrets/ai-worker/tls.key
AI_RABBITMQ_URL=amqps://rabbitmq.internal:5671/sme-integration
AI_RABBITMQ_CA_FILE=/run/secrets/ai-worker/broker-ca.crt
# AI_RABBITMQ_USERNAME/PASSWORD: separate consume-only identity, supplied externally.
AI_S3_ENDPOINT_URL=https://storage.internal:9000
AI_S3_CA_FILE=/run/secrets/ai-worker/storage-ca.crt
AI_S3_REGION=us-east-1
AI_S3_BUCKET=meeting-media
# AI_S3_ACCESS_KEY_ID/SECRET_ACCESS_KEY: separate worker identity, supplied externally.
# Read-only smoke check requires an operator-provisioned synthetic object, not meeting data.
E2E01_STORAGE_PROBE_KEY=integration/transport-probe.txt
