# SME Meeting Assistant - secure local infrastructure
# Canonical infrastructure configuration for infra/local/secure-integration/.env.
# This file contains only Compose interpolation and RabbitMQ/RustFS bootstrap
# settings. Core and AI application settings belong to services/api/.env and
# services/ai/.env. Never commit the local file or real credentials.

# Existing Smallstep CA endpoint used by ca.sh. This does not issue or rotate
# certificates; certificate operations remain explicit operator actions.
DEV_PKI_CA_URL=https://localhost:9000
DEV_PKI_CA_ROOT_FILE=/absolute/path/to/dev-pki/root_ca.crt

# Compose network identities. Preserve these names when the issued SANs use them.
BROKER_DNS=rabbitmq.internal
STORAGE_DNS=storage.internal
AI_DNS=ai-core.dev.example

# Existing, operator-approved TLS directories. These are host paths only.
BROKER_TLS_DIR=/absolute/path/to/secure-integration/broker-server
STORAGE_TLS_DIR=/absolute/path/to/secure-integration/storage-server
AI_TLS_DIR=/absolute/path/to/existing-dev-pki/server
WORKER_TLS_DIR=/absolute/path/to/secure-integration/worker-client
# Knowledge worker only. Provide an already enrolled Qdrant server directory;
# dev.sh never creates or rotates this certificate.
QDRANT_TLS_DIR=/absolute/path/to/secure-integration/qdrant-server
QDRANT_PORT=6333

# RabbitMQ bootstrap/admin identity. Application identities are configured in
# services/api/.env and services/ai/.env and must never reuse these values.
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
RABBITMQ_DEFAULT_VHOST=sme-integration

# RustFS bootstrap/admin identity. Runtime Core/worker identities are separate.
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
# Keep the Qdrant key in a mode-0600 protected one-line file outside Git.
# dev.sh renders this source into a private Compose interpolation file only.
QDRANT_API_KEY=
QDRANT_API_KEY_FILE=~/.local/share/sme-meeting/qdrant-api-key

# Synthetic object used only by the transport smoke check.
E2E01_STORAGE_PROBE_KEY=integration/transport-probe.txt

# The compose command supplies these generated, mode-0600 process files:
AI_HTTP_ENV_FILE=/private/runtime/ai-http.env
AI_TRANSCRIPTION_ENV_FILE=/private/runtime/transcription-worker.env
