# ============================================================
# SME Meeting Assistant - Secure Integration
# Environment: Local Development / WSL2 Ubuntu
# Template only. Copy to infra/local/secure-integration/.env
# Replace host paths and supply credentials locally.
# NEVER commit actual passwords, access keys, or private keys.
# ============================================================

# ============================================================
# 1. SMALLSTEP CA - PKI
# ============================================================
DEV_PKI_CA_URL=https://localhost:9000
DEV_PKI_CA_ROOT_FILE=/home/your-user/.local/share/sme-meeting/pki-dev/root_ca.crt

# ============================================================
# 2. AI TRANSCRIPTION WORKER - IDENTITY
# ============================================================
AI_SERVICE_NAME=sme-meeting-ai-worker
AI_SERVICE_IDENTITY=ai-worker
AI_ENVIRONMENT=development

# ============================================================
# 3. CORE API - OUTBOUND mTLS
# ============================================================
AI_CORE_API_BASE_URL=https://core-api.internal:8443
AI_CORE_API_SERVER_CA_FILE=/home/your-user/.local/share/sme-secure-integration-pki/worker-client/core-server-ca.crt
AI_CORE_API_CLIENT_CERT_FILE=/home/your-user/.local/share/sme-secure-integration-pki/worker-client/tls.crt
AI_CORE_API_CLIENT_KEY_FILE=/home/your-user/.local/share/sme-secure-integration-pki/worker-client/tls.key
AI_CORE_API_CONNECT_TIMEOUT_SECONDS=3
AI_CORE_API_TIMEOUT_SECONDS=15
AI_CORE_API_MAX_ATTEMPTS=3

# ============================================================
# 4. RABBITMQ - AMQPS (DEDICATED WORKER CONSUMER)
# ============================================================
AI_RABBITMQ_URL=amqps://rabbitmq.internal:5671/sme-integration
AI_RABBITMQ_CA_FILE=/home/your-user/.local/share/sme-secure-integration-pki/worker-client/broker-ca.crt
AI_RABBITMQ_USERNAME=sme-ai-worker
AI_RABBITMQ_PASSWORD=
AI_RABBITMQ_EXCHANGE=meeting.processing
AI_RABBITMQ_ROUTING_KEY=processing.job.queued
AI_RABBITMQ_QUEUE=meeting.processing.jobs
AI_RABBITMQ_DELIVERY_LIMIT=5

# ============================================================
# 5. RUSTFS / S3 - HTTPS (DEDICATED WORKER IDENTITY)
# ============================================================
AI_S3_ENDPOINT_URL=https://storage.internal:9443
AI_S3_CA_FILE=/home/your-user/.local/share/sme-secure-integration-pki/worker-client/storage-ca.crt
AI_S3_STORAGE_ID=private
AI_S3_REGION=us-east-1
AI_S3_BUCKET=meeting-media
AI_S3_PATH_STYLE=true
AI_S3_ACCESS_KEY_ID=
AI_S3_SECRET_ACCESS_KEY=
AI_S3_CONNECT_TIMEOUT_SECONDS=3
AI_S3_READ_TIMEOUT_SECONDS=15
AI_S3_DOWNLOAD_TIMEOUT_SECONDS=300

# ============================================================
# 6. WORKER EXECUTION
# ============================================================
AI_WORKER_CONCURRENCY=1
AI_WORKER_SHUTDOWN_TIMEOUT_SECONDS=30
AI_WORKER_EXECUTION_TIMEOUT_SECONDS=14400

# ============================================================
# 7. E2E TRANSPORT SMOKE TEST
# ============================================================
E2E01_STORAGE_PROBE_KEY=integration/transport-probe.txt

# ============================================================
# 8. RUSTFS BOOTSTRAP - ADMIN ONLY
# ============================================================
# These are RustFS bootstrap/admin credentials, NOT worker IAM credentials.
# Use only for provisioning or startup infrastructure scripts.
# Do not pass them to the AI Worker process.
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
