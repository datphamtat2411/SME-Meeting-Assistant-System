# Host-run Java/Spring configuration. Copy outside Git, mode 0600.
SPRING_PROFILES_ACTIVE=secure-integration
APP_TRANSPORT_PRIVATE_ENABLED=true
APP_TRANSPORT_PRIVATE_ADDRESS=127.0.0.1
APP_TRANSPORT_PRIVATE_PORT=8443
APP_TRANSPORT_PRIVATE_HOSTNAME=core-api.internal
APP_TRANSPORT_PRIVATE_CERTIFICATE=/absolute/secure-integration/core-server/tls.crt
APP_TRANSPORT_PRIVATE_KEY=/absolute/secure-integration/core-server/tls.key
APP_TRANSPORT_PRIVATE_ISSUER_CA=/absolute/secure-integration/core-server/issuer-ca.crt
APP_TRANSPORT_PRIVATE_CLIENT_CA=/absolute/secure-integration/core-server/client-ca.crt
APP_TRANSPORT_AI_ENABLED=true
APP_TRANSPORT_AI_PROBE=false
APP_TRANSPORT_AI_BASE_URL=https://ai-core.dev.example:8444
APP_TRANSPORT_AI_SERVER_CA=/absolute/secure-integration/core-client/ai-server-ca.crt
APP_TRANSPORT_AI_ISSUER_CA=/absolute/secure-integration/core-client/issuer-ca.crt
APP_TRANSPORT_AI_CERTIFICATE=/absolute/secure-integration/core-client/tls.crt
APP_TRANSPORT_AI_KEY=/absolute/secure-integration/core-client/tls.key
RABBITMQ_HOST=rabbitmq.internal
RABBITMQ_PORT=5671
RABBITMQ_VIRTUAL_HOST=sme-integration
RABBITMQ_CA_FILE=/absolute/secure-integration/core-client/broker-ca.crt
# Supply RABBITMQ_USERNAME/PASSWORD from the separate least-privilege Core identity.
APP_MEDIA_STORAGE_ENDPOINT=https://storage.internal:9443
APP_MEDIA_STORAGE_CA_FILE=/absolute/secure-integration/core-client/storage-ca.crt
APP_MEDIA_STORAGE_REGION=us-east-1
APP_MEDIA_STORAGE_BUCKET=meeting-media
# Supply APP_MEDIA_STORAGE_ACCESS_KEY/SECRET_KEY externally; never broker/storage admin credentials.
# Existing DB/JWT/SMTP settings remain required by the normal application.
