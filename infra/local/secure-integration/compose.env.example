# Copy OUTSIDE Git, mode 0600. These are host paths, not secret values.
BROKER_ENV_FILE=/absolute/secure-integration/operator/broker.env
STORAGE_ENV_FILE=/absolute/secure-integration/operator/storage.env
WORKER_ENV_FILE=/absolute/secure-integration/operator/worker.env
# Use a separate file and process identity for the MI worker; do not reuse the
# transcription worker account or certificate.
INTELLIGENCE_WORKER_ENV_FILE=/absolute/secure-integration/operator/intelligence-worker.env
BROKER_TLS_DIR=/absolute/secure-integration/broker-server
STORAGE_TLS_DIR=/absolute/secure-integration/storage-server
AI_TLS_DIR=/absolute/existing-dev-pki/server
WORKER_TLS_DIR=/absolute/secure-integration/worker-client
BROKER_DNS=rabbitmq.internal
STORAGE_DNS=storage.internal
# Must be the EXISTING validated AI server DNS SAN; do not rename the identity.
AI_DNS=ai-core.dev.example
